# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings → API). Both are safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Cloud (Feta project). Server-only keys: never NEXT_PUBLIC_.
# Gemini key from AI Studio (restricted to the Gemini API).
GEMINI_API_KEY=
# Separate key restricted to Places API (New).
GOOGLE_PLACES_API_KEY=

# Venice AI (OpenAI-compatible). Server-only.
VENICE_API_KEY=

# Only used by the n8n cost report, not by the app
USAGE_REPORT_KEY=

# Local test mode: made-up places instead of Google (never set in Vercel).
# FAKE_PLACES=1
# Daily spending limits (₹, India day). Defaults in code: everyone 1500,
# one person 250 (admins don't count), new pick searches per person 60.
DAILY_BUDGET_INR=
USER_DAILY_BUDGET_INR=
PICKS_USER_DAILY_LIMIT=
# Test accounts (?qa=1): their own pool, apart from real people's
TEST_DAILY_BUDGET_INR=
TEST_USER_DAILY_BUDGET_INR=
LIBRARY_BUDGET_INR=

# Ticketmaster Discovery API (free key in the founder's name, developer.ticketmaster.com): turns on its events feed
TICKETMASTER_API_KEY=

# The private tester code: opening Feta with ?qa=<this> marks the account as a test one (hash in supabase/migrations/20261123140000).
QA_CODE=
