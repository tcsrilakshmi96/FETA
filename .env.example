# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings → API). Both are safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Cloud (Feta project). Server-only keys: never NEXT_PUBLIC_.
# Gemini key from AI Studio (restricted to the Gemini API).
GEMINI_API_KEY=
# Separate key restricted to Places API (New).
GOOGLE_PLACES_API_KEY=

# Venice AI (OpenAI-compatible). Server-only.
VENICE_API_KEY=
